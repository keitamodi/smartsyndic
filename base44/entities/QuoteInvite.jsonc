{
  "name": "QuoteInvite",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_phone": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "telephone"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "email"
    },
    "status": {
      "type": "string",
      "enum": [
        "a_contacter",
        "envoyee",
        "repondue"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green"
      ],
      "default": "a_contacter"
    },
    "sent_at": {
      "type": "string",
      "format": "date"
    },
    "last_contact_at": {
      "type": "string",
      "format": "date"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "company_name"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}