{
  "name": "Provider",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "technicien_interne",
        "prestataire_externe"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "specialty": {
      "type": "string",
      "enum": [
        "plomberie",
        "electricite",
        "chauffage",
        "ascenseur",
        "toiture",
        "espaces_verts",
        "nettoyage",
        "securite",
        "multiservices",
        "serrurerie",
        "gardiennage",
        "autre"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "pink",
        "purple",
        "gray",
        "green",
        "green",
        "red",
        "blue",
        "blue",
        "green",
        "gray"
      ]
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "siret": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "inactif"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "actif"
    },
    "rating": {
      "type": "number",
      "description": "Note interne de 1 \u00e0 5"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}