{
  "name": "Syndic",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du cabinet ou du syndicat de copropri\u00e9taires"
    },
    "siret": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "professionnel",
        "benevole",
        "cooperatif"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "description": "Type de syndic"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "expert"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green"
      ],
      "default": "free",
      "description": "Forfait d'abonnement du cabinet"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "essai",
        "suspendu"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "actif"
    },
    "contact_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}