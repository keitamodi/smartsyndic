{
  "name": "Syndic",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string",
      "description": "Identifiant du cabinet (\u00e9gal \u00e0 son propre id) : sert au cloisonnement des donn\u00e9es."
    },
    "name": {
      "type": "string",
      "description": "Nom du cabinet ou du syndicat de copropri\u00e9taires"
    },
    "siret": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "professionnel",
        "benevole",
        "cooperatif"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "description": "Type de syndic"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "expert"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green"
      ],
      "default": "free",
      "description": "Forfait d'abonnement du cabinet"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "essai",
        "suspendu"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "actif"
    },
    "contact_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Client Stripe du cabinet (rempli par le paiement en ligne)"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Abonnement Stripe actif du cabinet"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "aucun",
        "actif",
        "impaye",
        "resilie"
      ],
      "enumColors": [
        "gray",
        "green",
        "red",
        "gray"
      ],
      "default": "aucun",
      "description": "\u00c9tat de l'abonnement Stripe"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}