{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "Action r\u00e9alis\u00e9e, ex. cr\u00e9ation, mise \u00e0 jour, suppression"
    },
    "entity": {
      "type": "string",
      "description": "Nom de l'entit\u00e9 concern\u00e9e"
    },
    "entity_label": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}