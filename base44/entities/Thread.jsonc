{
  "name": "Thread",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_kind": {
      "type": "string",
      "enum": [
        "coproprietaire",
        "proprietaire",
        "occupant",
        "technicien",
        "prestataire",
        "equipe"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "pink",
        "gray"
      ],
      "default": "coproprietaire"
    },
    "building_id": {
      "type": "string"
    },
    "building_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ouvert",
        "en_attente",
        "clos"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "gray"
      ],
      "default": "ouvert"
    },
    "last_message": {
      "type": "string"
    },
    "last_author": {
      "type": "string"
    },
    "unread_count": {
      "type": "number"
    }
  },
  "required": [
    "subject",
    "contact_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        },
        {
          "data.contact_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}