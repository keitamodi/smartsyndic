{
  "name": "Intervention",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "building_id": {
      "type": "string"
    },
    "building_name": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "preventive",
        "curative",
        "controle"
      ],
      "enumColors": [
        "blue",
        "red",
        "purple"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "entretien",
        "depannage"
      ],
      "enumColors": [
        "blue",
        "red"
      ],
      "default": "entretien",
      "description": "Entretien programm\u00e9 ou d\u00e9pannage"
    },
    "priority": {
      "type": "string",
      "enum": [
        "basse",
        "normale",
        "haute",
        "urgente"
      ],
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "red"
      ],
      "default": "normale",
      "description": "Degr\u00e9 d'urgence : urgente (rouge), haute (orange), normale (bleu), basse (gris)"
    },
    "status": {
      "type": "string",
      "enum": [
        "planifiee",
        "en_cours",
        "terminee",
        "annulee"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "gray"
      ],
      "default": "planifiee"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string",
      "description": "Heure de d\u00e9but, format HH:MM"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60,
      "description": "Dur\u00e9e pr\u00e9vue en minutes"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string",
      "description": "Nom de l'intervenant (annuaire ou saisi librement)"
    },
    "provider_email": {
      "type": "string",
      "description": "Email du compte du technicien : lui ouvre l'intervention dans son espace"
    },
    "provider_phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone de l'intervenant \u00e0 joindre sur place"
    },
    "provider_trade": {
      "type": "string",
      "description": "M\u00e9tier de l'intervenant : serrurerie, gardiennage, plomberie\u2026 ou autre"
    },
    "cost": {
      "type": "number"
    },
    "report": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contact_email": {
      "type": "string",
      "description": "Personne \u00e0 pr\u00e9venir (propri\u00e9taire) pour un d\u00e9pannage"
    },
    "reminder_days": {
      "type": "number",
      "default": 7,
      "description": "Nombre de jours avant l'\u00e9ch\u00e9ance pour envoyer l'alerte"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "late_alert_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        },
        {
          "data.provider_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        },
        {
          "data.provider_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}