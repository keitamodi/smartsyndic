{
  "name": "MemberInvite",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Adresse invit\u00e9e (renseign\u00e9e \u00e0 l'activation si l'invitation part par t\u00e9l\u00e9phone)"
    },
    "phone": {
      "type": "string",
      "description": "Num\u00e9ro invit\u00e9 quand le lien part par SMS ou WhatsApp"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "whatsapp"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "default": "email",
      "description": "Canal de transmission du lien d'inscription"
    },
    "full_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "coproprietaire",
        "proprietaire",
        "locataire",
        "technicien"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow"
      ],
      "description": "Profil ouvert par le syndic"
    },
    "member_id": {
      "type": "string",
      "description": "Fiche (r\u00e9sident ou prestataire) rattach\u00e9e \u00e0 l'invitation"
    },
    "member_type": {
      "type": "string",
      "enum": [
        "resident",
        "provider"
      ],
      "enumColors": [
        "blue",
        "yellow"
      ]
    },
    "building_id": {
      "type": "string"
    },
    "building_name": {
      "type": "string"
    },
    "lot_numbers": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "Jeton du lien d'inscription envoy\u00e9 \u00e0 la personne"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "acceptee",
        "annulee"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "en_attente"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "sent_at": {
      "type": "string",
      "format": "date"
    },
    "accepted_at": {
      "type": "string",
      "format": "date"
    },
    "invited_by": {
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}