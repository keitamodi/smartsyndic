{
  "name": "SignupRequest",
  "type": "object",
  "properties": {
    "syndic_name": {
      "type": "string",
      "description": "Nom du cabinet ou du syndicat de copropri\u00e9taires"
    },
    "syndic_kind": {
      "type": "string",
      "enum": [
        "professionnel",
        "benevole",
        "cooperatif"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "default": "professionnel"
    },
    "contact_name": {
      "type": "string",
      "description": "Nom et pr\u00e9nom du r\u00e9f\u00e9rent"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "buildings_count": {
      "type": "number",
      "description": "Nombre d'immeubles g\u00e9r\u00e9s"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nouveau",
        "contacte",
        "qualifie",
        "refuse"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "nouveau"
    },
    "source": {
      "type": "string",
      "default": "page_accueil"
    }
  },
  "required": [
    "syndic_name",
    "contact_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}