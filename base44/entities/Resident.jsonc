{
  "name": "Resident",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "building_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "coproprietaire",
        "proprietaire_bailleur",
        "occupant"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ]
    },
    "lot_numbers": {
      "type": "string",
      "description": "Lots rattach\u00e9s, s\u00e9par\u00e9s par une virgule"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "sorti"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "actif"
    },
    "access_invited": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}