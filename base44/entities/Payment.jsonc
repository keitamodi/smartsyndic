{
  "name": "Payment",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "building_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "enum": [
        "virement",
        "prelevement",
        "cheque",
        "especes",
        "en_ligne"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray",
        "yellow",
        "green"
      ]
    },
    "reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "recu",
        "en_attente",
        "rejete"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "recu"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}