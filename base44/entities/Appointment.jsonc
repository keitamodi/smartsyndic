{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "building_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "intervention",
        "visite",
        "assemblee",
        "reunion"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "Format HH:MM"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "participants": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planifie",
        "confirme",
        "realise",
        "annule"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray",
        "red"
      ],
      "default": "planifie"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}