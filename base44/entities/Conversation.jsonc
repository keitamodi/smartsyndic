{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "syndic",
        "resident"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "syndic",
      "description": "syndic : assistance interne ; resident : questions de copropri\u00e9taires sur leurs droits et devoirs"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "data.syndic_id": "{{user.data.syndic_id}}"
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.syndic_id": "{{user.data.syndic_id}}"
            },
            {
              "user_condition": {
                "data.syndic_scope": "equipe"
              }
            }
          ]
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}