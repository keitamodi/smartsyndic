{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "syndic",
        "resident"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "syndic",
      "description": "syndic : assistance interne ; resident : questions de copropri\u00e9taires sur leurs droits et devoirs"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}