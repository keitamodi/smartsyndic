{
  "name": "Building",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string",
      "description": "Espace syndic propri\u00e9taire de l'immeuble"
    },
    "name": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "residentiel",
        "mixte",
        "commercial"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow"
      ]
    },
    "floors": {
      "type": "number"
    },
    "units_count": {
      "type": "number"
    },
    "year_built": {
      "type": "number"
    },
    "manager_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "travaux",
        "archive"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "actif"
    },
    "image_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}