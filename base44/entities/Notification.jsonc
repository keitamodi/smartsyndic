{
  "name": "Notification",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ticket",
        "intervention",
        "facture",
        "contrat",
        "assemblee",
        "systeme"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "green",
        "pink",
        "gray"
      ]
    },
    "read": {
      "type": "boolean"
    },
    "link": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}