{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "administrateur",
        "directeur",
        "gestionnaire",
        "assistant",
        "comptable"
      ],
      "enumColors": [
        "red",
        "purple",
        "blue",
        "green",
        "yellow"
      ]
    },
    "building_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "P\u00e9rim\u00e8tre d'immeubles autoris\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "invite",
        "desactive"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "invite"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}