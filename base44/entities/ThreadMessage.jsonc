{
  "name": "ThreadMessage",
  "type": "object",
  "properties": {
    "syndic_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "sortant",
        "entrant"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "sortant"
    },
    "author_name": {
      "type": "string"
    },
    "author_kind": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "body"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.syndic_id": "{{user.data.syndic_id}}"
        },
        {
          "user_condition": {
            "data.syndic_scope": "equipe"
          }
        }
      ]
    }
  }
}